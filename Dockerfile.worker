FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PATH="/root/.local/bin:${PATH}"

ARG CODEX_CLI_VERSION=0.146.0

WORKDIR /app

# The Worker image is the only image that contains Codex CLI. The API and MCP
# images remain unable to execute it, and the runner stays disabled by default.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates nodejs npm \
    && npm install --global "@openai/codex@${CODEX_CLI_VERSION}" \
    && command -v codex \
    && codex --version \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

COPY . /app
RUN pip install --no-cache-dir .

CMD ["python", "-m", "codex_memory.worker", "--mode", "async", "--poll-interval", "2", "--reflection-schedule", "02:00"]
