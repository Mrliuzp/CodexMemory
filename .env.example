POSTGRES_DB=codex_memory
POSTGRES_USER=codex
POSTGRES_PASSWORD=change-me
CODEX_MEMORY_DATABASE_URL=postgresql+psycopg://codex:change-me@postgres:5432/codex_memory
CODEX_MEMORY_SERVICE_TOKEN=change-me
CODEX_MEMORY_MCP_TOKEN=change-me-mcp-token
CODEX_MEMORY_BOOTSTRAP_PROJECT_KEY=demo
CODEX_MEMORY_BOOTSTRAP_PROJECT_NAME=Demo
CODEX_MEMORY_EMBEDDING_DIMENSION=1536
# 项目 L1 自动发布的初始置信度阈值，可由 Admin 决策策略按项目覆盖。
CODEX_MEMORY_L1_AUTO_PUBLISH_THRESHOLD=0.80
# Admin Web 登录配置。
CODEX_MEMORY_ADMIN_USERNAME=change-me-admin-username
CODEX_MEMORY_ADMIN_PASSWORD=change-me-admin-password
CODEX_MEMORY_ADMIN_SESSION_SECRET=change-me-admin-session-secret
CODEX_MEMORY_ADMIN_PROJECT_KEY=demo

# Codex CLI 模型判断执行器默认关闭；启用前需单独评估认证、预算和隔离边界。
CODEX_MEMORY_CODEX_CLI_ENABLED=false
CODEX_MEMORY_CODEX_CLI_PATH=codex
CODEX_MEMORY_CODEX_CLI_PROFILE=
CODEX_MEMORY_CODEX_CLI_MODEL=
CODEX_MEMORY_CODEX_CLI_TIMEOUT_SECONDS=60
CODEX_MEMORY_CODEX_CLI_MAX_CONCURRENCY=1
CODEX_MEMORY_CODEX_CLI_CONTEXT_BUDGET_TOKENS=4000
CODEX_MEMORY_CODEX_CLI_DAILY_BUDGET_TOKENS=20000
CODEX_MEMORY_CODEX_CLI_MAX_OUTPUT_BYTES=65536

# Optional local login coordinator. Use only with docker-compose.codex-auth.yml;
# keep the coordinator token and the persistent auth directory outside this file.
# CODEX_MEMORY_CODEX_AUTH_COORDINATOR_URL=http://host.docker.internal:1456
# CODEX_MEMORY_CODEX_AUTH_COORDINATOR_TOKEN=
# CODEX_MEMORY_CODEX_CLI_AUTH_DIR=
# Build-only proxy inputs for the official Worker CLI download; do not put
# credentials here or promote these values to runtime environment variables.
# CODEX_BUILD_HTTP_PROXY=
# CODEX_BUILD_HTTPS_PROXY=
# CODEX_BUILD_NO_PROXY=localhost,127.0.0.1,host.docker.internal,postgres,api
