{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "commandWindows": "python .codex/scripts/append_user.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "commandWindows": "python .codex/scripts/append_assistant.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
